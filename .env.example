# Copy to .env (never commit it). The app works with NONE of these set (basic mode).

# Option A: free Gemini API key from https://aistudio.google.com/apikey  (no billing account needed)
GEMINI_API_KEY=

# Option B: Google Cloud credits through Vertex AI (use when you have credits)
# USE_VERTEX=1
# GOOGLE_CLOUD_PROJECT=claimback-515215
# GOOGLE_CLOUD_LOCATION=global

# Option C: 100% free local open model (Gemma) with Ollama, text only
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=gemma3

# Optional
# GEMINI_MODEL=            # force a model id, or a comma list to try in order
REVIEWER_PIN=claimback
RATE_LIMIT_PER_HOUR=40
